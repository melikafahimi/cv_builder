# ─────────────────────────────────────────────
# Resume Builder SaaS — Environment Variables
# Copy this file to `.env.local` and fill in values.
# ─────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_NAME="CV Builder"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (Postgres / Prisma-ready)
DATABASE_URL="postgresql://user:password@localhost:5432/cv_builder?schema=public"

# Auth (NextAuth-style secrets)
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# OAuth providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Storage (for profile pictures / avatars)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Feature flags
NEXT_PUBLIC_ENABLE_OAUTH="false"
NEXT_PUBLIC_ENABLE_AI_ASSIST="false"